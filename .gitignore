# ── Housekeeping for the public repo ──────────────────────────────
# Local environment / CI scaffolding (not part of the ShopNest app)
/.zscripts/
/tool-results/
/examples/
/download/
/Caddyfile

# Databases are NEVER committed (they contain account hashes + order data).
# Generate one with `bun run db:seed` after cloning.
db/*.db
db/*.db-journal

# QA screenshots / ephemeral artifacts
scripts/*.png

# Multi-agent build log — internal working notes, not part of the app
worklog.md

# Allow the committed example env (see .env.example)
!.env.example

# Generated second Prisma client (rate-limit DB) — created by db:generate / postinstall
/src/generated/
