# ── ShopNest storefront environment ────────────────────────────────
# Copy to .env and adjust. NEVER commit real secrets to git.
#
# Phase-9 architecture: this app is a pure UI + proxy tier. ALL business
# logic, database access, rate limiting, mail delivery and admin functions
# live in the Workers API (apps/api). Only three variables matter here.

# Session signing secret — the edge middleware pre-verifies customer JWTs
# with it (the API re-verifies every request against the database).
# MUST be the SAME value the Workers API runs with, or login will loop.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Origin of the Workers API the /api/* proxy and server components call.
#   Local dev:  http://localhost:8787 (wrangler dev default — fallback)
#   Production: https://api.your-domain.com
# BACKEND_ORIGIN=http://localhost:8787

# Public origin of this site — used by robots.txt and sitemap.xml.
# INLINED AT BUILD TIME: set it when you run `next build`.
#   Local dev:  http://localhost:3000 (fallback)
#   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ── Everything else lives in the Workers API's environment ─────────
# RESEND_API_KEY, MAIL_FROM, TOTP_ENC_KEY, TRUST_PROXY, REQUIRE_GUEST_EMAIL_OTP,
# REQUIRE_VERIFIED_EMAIL, DATABASE (D1), MEDIA (R2)… → see apps/api/wrangler.jsonc
# and apps/api/.dev.vars.example. Admin secrets → apps/admin/.env.example.
