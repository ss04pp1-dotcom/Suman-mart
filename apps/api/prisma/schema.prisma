// ShopNest — E-commerce & Dropshipping Platform
// SQLite locally / Cloudflare D1 compatible (see database/schema.sql for D1 DDL)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "workerd"
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./placeholder.db"
}

// ─────────────────────────────── Identity & Access ───────────────────────────────

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  // SUPER_ADMIN | ADMIN | MANAGER | SUPPORT | MARKETING
  role         String    @default("ADMIN")
  // JSON array of permission overrides, e.g. ["analytics.view"]
  permissions  String?
  // Bumped on password change / deactivation → invalidates all existing JWTs
  tokenVersion Int       @default(0)
  // Forces a password change before any admin action is allowed
  mustChangePassword Boolean @default(false)
  // TOTP two-factor auth (encrypted at rest: v1:<iv>:<ciphertext>, key derived
  // from ADMIN_SESSION_SECRET — see src/lib/totp.ts)
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  // Highest TOTP time-step successfully used — blocks code replay within the
  // ±1 step verification window (null until 2FA is first used)
  totpLastStep Int?
  // One-time 2FA recovery codes (hashed, shown to the admin exactly once)
  recoveryCodes AdminRecoveryCode[]
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
}

model Customer {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  phone           String?
  avatarUrl       String?
  // Bumped on password change / deactivation → invalidates all existing JWTs
  tokenVersion    Int       @default(0)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  coupons   Coupon[]
  authTokens AuthToken[]
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  label      String  @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  area       String?
  postalCode String?
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  coupons  Coupon[]

  @@index([parentId])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?
  // All money fields are integers in BDT taka (no cents)
  price            Int
  compareAtPrice   Int?
  costPrice        Int?
  sku              String   @unique
  stock            Int      @default(0)
  lowStockThreshold Int     @default(5)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  brand            String?
  // JSON: [{ "group": "Display", "key": "Screen", "value": "1.9 inch AMOLED" }]
  specifications   String?
  seoTitle         String?
  seoDescription   String?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  soldCount        Int      @default(0)
  viewCount        Int      @default(0)
  categoryId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  tags             ProductTag[]
  reviews          Review[]
  relationsFrom    ProductRelation[] @relation("FromProduct")
  relationsTo      ProductRelation[] @relation("ToProduct")
  orderItems       OrderItem[]
  coupons          Coupon[]
  supplierProduct  SupplierProduct?

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  // JSON: {"Color": "Black", "Size": "M"}
  options   String
  sku       String?
  price     Int?
  stock     Int    @default(0)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Tag {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag      Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// Manual recommendations: RELATED ("You May Also Like") & FBT ("Frequently Bought Together")
model ProductRelation {
  id              String @id @default(cuid())
  productId       String
  relatedProductId String
  // RELATED | FBT
  type            String @default("RELATED")
  sortOrder       Int    @default(0)

  product       Product @relation("FromProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ToProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
}

// ─────────────────────────────── Suppliers / Dropshipping ───────────────────────────────

model Supplier {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  email         String?
  phone         String?
  // Adapter key, e.g. "demo-wholesale-v1", "aliexpress-v1"
  adapter       String    @default("demo-wholesale-v1")
  baseUrl       String?
  // Server-side only credentials — never returned to any client
  apiKey        String?
  apiSecret     String?
  autoSyncPrice Boolean   @default(true)
  autoSyncStock Boolean   @default(true)
  // Mapping overrides: JSON { "price": { "markupPercent": 25 }, "category": {"Electronics": "electronics"} }
  config        String?
  isActive      Boolean   @default(true)
  notes         String?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products       SupplierProduct[]
  syncLogs       SupplierSyncLog[]
  orders         SupplierOrder[]
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  productId    String?  @unique
  externalId   String
  name         String
  description  String?
  // JSON array of image URLs
  images       String?
  price        Int
  stock        Int
  sku          String?
  category     String?
  // JSON: [{ "group": "Color", "options": ["Black", "White"] }]
  variants     String?
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([supplierId, externalId])
  @@index([supplierId])
}

model SupplierSyncLog {
  id             String   @id @default(cuid())
  supplierId     String
  // PRODUCTS | PRICES | STOCK
  type           String
  // SUCCESS | PARTIAL | FAILED
  status         String
  message        String?
  itemsProcessed Int      @default(0)
  itemsCreated   Int      @default(0)
  itemsUpdated   Int      @default(0)
  itemsFailed    Int      @default(0)
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
}

model SupplierOrder {
  id               String    @id @default(cuid())
  supplierId       String
  orderId          String
  externalOrderId  String?
  // PENDING | PLACED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | FAILED
  status           String    @default("PENDING")
  itemsTotal       Int       @default(0)
  shippingFee      Int       @default(0)
  total            Int       @default(0)
  trackingNumber   String?
  courier          String?
  // Delivery attempts (background worker retries transient failures)
  attempts         Int       @default(0)
  lastError        String?
  // JSON snapshot of last status payload from supplier API
  statusPayload    String?
  placedAt         DateTime?
  lastCheckedAt    DateTime?
  cancelRequestedAt DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([orderId])
}

// ─────────────────────────────── Orders ───────────────────────────────

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  customerId  String?
  // Guest snapshots (used for guest checkout + tracking lookup)
  customerName  String
  customerPhone String
  customerEmail String?
  // PENDING | CONFIRMED | PROCESSING | SHIPPED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | CANCELLED | RETURNED
  status        String  @default("PENDING")
  // UNPAID | PAID | COD_PENDING | REFUNDED
  paymentStatus String  @default("COD_PENDING")
  // COD | BKASH | NAGAD | CARD
  paymentMethod String  @default("COD")
  subtotal      Int
  discountTotal Int     @default(0)
  shippingTotal Int     @default(0)
  // Cash-on-delivery handling fee (from shipping settings)
  codCharge     Int     @default(0)
  // Set when stock was returned after cancellation/return (idempotency guard)
  stockRestoredAt DateTime?
  // Crypto-random token written by the winning restock claim (see apps/api src/lib/order-flow.ts)
  stockRestoreToken String?
  total         Int
  couponCode    String?
  // JSON snapshot: { fullName, phone, line1, line2, city, area, postalCode }
  shippingAddress String
  customerNote    String?
  internalNotes   String?
  // Shared ID for browser+server Purchase event deduplication
  purchaseEventId String?
  courier           String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  supplierOrders SupplierOrder[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  // Snapshot fields survive product deletion
  name      String
  sku       String
  imageUrl  String?
  unitPrice Int
  quantity  Int
  total     Int
  // JSON: {"Color": "Black"}
  options   String?
  supplierId String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  // "system" | "admin:{adminId}" | "supplier"
  createdBy String   @default("system")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  method        String
  // PENDING | SUCCESS | FAILED | REFUNDED
  status        String   @default("PENDING")
  amount        Int
  currency      String   @default("BDT")
  transactionId String? @unique
  // JSON provider payload (never contains secrets)
  providerPayload String?
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────── Marketing ───────────────────────────────

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  // PERCENTAGE | FIXED | FREE_SHIPPING
  type             String
  value            Int       @default(0)
  minOrderAmount   Int?
  maxDiscount      Int?
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  usageLimit       Int?
  usageCount       Int       @default(0)
  perCustomerLimit Int?
  productId        String?
  categoryId       String?
  customerId       String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  buttonLabel String?
  buttonUrl   String?
  // HERO | PROMO
  placement   String   @default("HERO")
  // Light | Dark — controls overlay text tone
  theme       String   @default("Dark")
  sortOrder   Int      @default(0)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Homepage section ordering & visibility
model HomepageSection {
  id        String  @id @default(cuid())
  key       String  @unique
  // hero | categories | featured | newArrivals | bestSellers | specialOffers | reviews | whyUs | shipping
  type      String
  title     String
  subtitle  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  customerId  String?
  orderId     String?
  authorName  String
  rating      Int
  title       String?
  comment     String
  // True when the reviewer has a delivered order containing this product
  verifiedPurchase Boolean @default(false)
  // PENDING | APPROVED | REJECTED | HIDDEN
  status      String   @default("PENDING")
  isFeatured  Boolean  @default(false)
  adminReply  String?
  createdAt   DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status])
}

// ─────────────────────────────── Settings ───────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── Tracking & Analytics ───────────────────────────────

model TrackingSession {
  id           String   @id @default(cuid())
  sessionKey   String   @unique
  customerKey  String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  // MOBILE | DESKTOP | TABLET
  device       String   @default("DESKTOP")
  browser      String?
  os           String?
  country      String?
  region       String?
  // DIRECT | GOOGLE | FACEBOOK | INSTAGRAM | TIKTOK | OTHER
  source       String   @default("DIRECT")
  medium       String   @default("none")
  campaign     String?
  content      String?
  term         String?
  referrer     String?
  landingPath  String?
  pageViewCount Int    @default(0)
  isReturning  Boolean  @default(false)

  events  TrackingEvent[]
  consents CookieConsent[]

  @@index([lastSeenAt])
  @@index([source])
  @@index([campaign])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  // Dedup key shared by browser + server copies of the same logical event
  eventId     String
  sessionId   String
  // PageView | ViewContent | Search | AddToCart | ViewCart | InitiateCheckout | AddPaymentInfo | Purchase | AddToWishlist | SignUp | Login | Lead
  name        String
  url         String?
  productId   String?
  productName String?
  searchQuery String?
  searchResults Int?
  value       Int?
  currency    String   @default("BDT")
  quantity    Int?
  // BROWSER | SERVER
  source      String   @default("BROWSER")
  // Per-provider delivery status: SUCCESS | ERROR | SKIPPED | null (not enabled)
  metaStatus  String?
  ga4Status   String?
  tiktokStatus String?
  deliveryError String?
  // Denormalized from session for fast analytics
  device      String?
  browser     String?
  os          String?
  country     String?
  trafficSource String?
  campaign    String?
  createdAt   DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([eventId, source])
  @@index([name, createdAt])
  @@index([sessionId])
  @@index([productId])
  @@index([createdAt])
  @@index([trafficSource])
}

model TrackingIntegration {
  id           String    @id @default(cuid())
  // META | GOOGLE | TIKTOK | CUSTOM
  provider     String    @unique
  // Public config (pixel IDs etc.) — safe to expose to browser
  config       String
  // Secrets (access tokens, api secrets) — server-side only, never sent to browser
  secrets      String
  isEnabled    Boolean   @default(false)
  // CONNECTED | ERROR | DISABLED
  status       String    @default("DISABLED")
  lastError    String?
  lastCheckedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model CookieConsent {
  id        String   @id @default(cuid())
  sessionId String
  // ACCEPT_ALL | ESSENTIAL_ONLY | CUSTOM | REJECTED
  choice    String
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  createdAt DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ─────────────────────────────── Ops ───────────────────────────────

// Atomic sequence allocator (order numbers, etc.) — increments happen in a
// single UPDATE … RETURNING statement so concurrent checkouts never collide.
model SequenceCounter {
  key   String @id
  value Int    @default(0)
}

// One-time tokens: PASSWORD_RESET | EMAIL_VERIFY. Only the SHA-256 hash of the
// token is stored; the raw token lives solely in the emailed link.
model AuthToken {
  id          String    @id @default(cuid())
  kind        String
  customerId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, kind])
}

// One-time email OTP for GUEST checkout (round-4 audit: without it, anyone
// could place orders with someone else's email and have the platform send
// that person unsolicited "order confirmation" mail). Only required while a
// mail provider is configured — without a provider no mail leaves the server,
// so there is nothing to abuse.
model GuestEmailOtp {
  id        String   @id @default(cuid())
  email     String
  // SHA-256 of the 6-digit code — a DB leak reveals nothing usable
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  // Wrong-entry counter — 5 misses invalidate the code (10^6 space brute-force)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// One-time 2FA recovery codes. Each code is shown to the admin exactly once
// (at 2FA enable / regeneration) and stored only as a SHA-256 lookup hash —
// a database leak reveals nothing usable. Login consumes a code atomically
// (conditional updateMany on usedAt IS NULL), so a code can never be spent
// twice. Used when the authenticator device is lost (otherwise the admin
// would be permanently locked out of the console).
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  adminId   String
  // SHA-256 hex of the normalized code (uppercase, separators stripped) —
  // deliberately key-free so rotating secrets never breaks lookups.
  lookupHash String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Customer-facing email outbox. A real provider (Resend / SMTP) sends these;
// without provider credentials mails stay PENDING here for inspection.
// Sensitive query params (reset/verify tokens) are REDACTED before storage.
model MailOutbox {
  id        String    @id @default(cuid())
  toEmail   String
  subject   String
  body      String
  // PENDING | SENT | FAILED | SKIPPED_NO_PROVIDER
  status    String    @default("PENDING")
  provider  String?
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  // ORDER | PAYMENT | STOCK | SUPPLIER | TRACKING | REVIEW | SYSTEM
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId])
}
