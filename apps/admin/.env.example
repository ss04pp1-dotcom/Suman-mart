# ── Admin application (apps/admin) ────────────────────────────────────
# The admin app is a PURE UI deployment: no database access, no business
# logic, no local secrets beyond the edge guard key. Every /api/admin/*
# request + media path is proxied at REQUEST time to BACKEND_ORIGIN
# (src/lib/backend-proxy.ts), and the shell layout's session check calls
# the Workers API's /v1/admin/auth/me.

# Where the Workers API lives (apps/api — `wrangler dev` serves 8787).
#   Local dev:  http://localhost:8787 (fallback)
#   Production: https://api.your-domain.com
BACKEND_ORIGIN=http://localhost:8787

# Public origin of THIS app (metadata, absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The admin session secret — ONLY used by the edge middleware to cheaply
# pre-verify the sn_admin JWT before a request reaches the app (the Workers
# API re-verifies every request against the database: active account +
# tokenVersion). MUST match the API's ADMIN_SESSION_SECRET
# (wrangler secret put ADMIN_SESSION_SECRET).
ADMIN_SESSION_SECRET=change-me-32-bytes-min

# All other configuration (mail, TOTP encryption, rate limits, policy
# switches, D1/R2 bindings) lives in the Workers API's environment —
# see apps/api/.dev.vars.example and apps/api/wrangler.jsonc.
