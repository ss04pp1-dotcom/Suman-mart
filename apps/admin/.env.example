# ── Admin application (apps/admin) ────────────────────────────────────
# The admin app is a PURE UI deployment: no database access at runtime, no
# business logic. Every /api/admin/* request + media path is proxied at
# REQUEST time to BACKEND_ORIGIN (src/lib/backend-proxy.ts).

# Where the shared backend lives. Today: the storefront service's Node API
# (http://localhost:3000 in dev, https://shop.example.com in production).
# Once the admin write-paths port to the Cloudflare Workers API, this flips
# to https://api.example.com — no code change.
BACKEND_ORIGIN=http://localhost:3000

# Public origin of THIS app (metadata, any absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Only needed for typecheck-time Prisma client generation ──────────
# The admin app copies the storefront's Prisma schema to generate types;
# it never opens the database at runtime. Point it at the same shared
# database the storefront uses (absolute path in dev sandboxes).
DATABASE_URL=file:/absolute/path/to/db/custom.db
RATELIMIT_DATABASE_URL=file:/absolute/path/to/db/ratelimit.db

# Session secrets are owned by the BACKEND — the admin app itself sets no
# cookies. These two are only read by the copied middleware (edge guards)
# and must match the backend's values while the storefront serves /api/*.
SESSION_SECRET=change-me-32-bytes-min
ADMIN_SESSION_SECRET=change-me-32-bytes-min
